<UserControl x:Class="IOCX.Wpf.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IOCX.Wpf.Converters"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:RiskLevelToBrushConverter x:Key="RiskAccent"/>
        <conv:RiskLevelToFillConverter x:Key="RiskFill"/>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="#FF444444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Destructive actions are visually distinct from ordinary ones. -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="#FF6B2B2B"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FF1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,24,24,0">
            <TextBlock Text="Investigation History" Foreground="White" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#FF9E9E9E" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Search and bulk actions -->
        <Grid Grid.Row="1" Margin="24,16,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Padding="8,6" FontSize="13" MaxWidth="380"
                     HorizontalAlignment="Left" MinWidth="260"
                     Background="#FF2D2D2D" Foreground="White" BorderBrush="#FF4A4A4A"
                     VerticalContentAlignment="Center"
                     ToolTip="Filter by indicator, type, or risk level"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Refresh" Style="{StaticResource ToolButton}"
                        Command="{Binding RefreshCommand}"/>
                <Button Content="Clear all" Style="{StaticResource DangerButton}"
                        Command="{Binding ClearAllCommand}"
                        ToolTip="Delete every stored investigation"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="24,16,24,24">
            <!-- Empty state -->
            <Border Background="#FF2D2D2D" CornerRadius="6" Padding="18"
                    VerticalAlignment="Top"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Nothing to show" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Foreground="#FF9E9E9E" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Investigations you run are stored locally and listed here. If you expected results, check your search filter."/>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FF2D2D2D" CornerRadius="6" Margin="0,0,0,10"
                                    BorderThickness="3,0,0,0"
                                    BorderBrush="{Binding RiskLevel, Converter={StaticResource RiskAccent}}">
                                <Grid Margin="15,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Value}" Foreground="White" FontSize="15"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Border Background="#FF3D3D3D" CornerRadius="3" Padding="6,2">
                                                <TextBlock Text="{Binding Type}" Foreground="#FF9E9E9E" FontSize="11"/>
                                            </Border>
                                            <TextBlock Text="{Binding StartedAt, StringFormat={}{0:MMM dd, yyyy HH:mm}}"
                                                       Foreground="#FF9E9E9E" FontSize="11" Margin="10,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ObservationCount, StringFormat={}{0} provider observation(s)}"
                                                   Foreground="#FF7E7E7E" FontSize="11" Margin="0,5,0,0"/>
                                    </StackPanel>


                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                        <Border CornerRadius="4" Padding="10,4" HorizontalAlignment="Right"
                                                Background="{Binding RiskLevel, Converter={StaticResource RiskFill}}"
                                                BorderThickness="1"
                                                BorderBrush="{Binding RiskLevel, Converter={StaticResource RiskAccent}}">
                                            <TextBlock Text="{Binding RiskLevel}" FontSize="12" FontWeight="Bold"
                                                       Foreground="{Binding RiskLevel, Converter={StaticResource RiskAccent}}"/>
                                        </Border>
                                        <TextBlock Text="{Binding RiskScore, StringFormat=Risk {0}/100}"
                                                   Foreground="#FF9E9E9E" FontSize="11"
                                                   HorizontalAlignment="Right" Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding ConfidenceScore, StringFormat=Confidence {0}%}"
                                                   Foreground="#FF6FCF5A" FontSize="11"
                                                   HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="Delete" VerticalAlignment="Center"
                                            Style="{StaticResource DangerButton}"
                                            Command="{Binding DataContext.DeleteCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Delete this investigation and its provider results"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
