<UserControl x:Class="IOCX.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,24,0,8"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFB8B8B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="NumberBox" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Background" Value="#FF1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF4A4A4A"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#FF3D6FA8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#FF444444"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FF1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="24,24,24,0">
            <TextBlock Text="Settings" Foreground="White" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Configure intelligence providers, credentials, caching, and risk thresholds."
                       Foreground="#FF9E9E9E" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="24,16,24,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Privacy notice. Belongs on screen, not buried in the docs. -->
                <Border Background="#FF33291A" BorderBrush="#FFE0A33C" BorderThickness="1"
                        CornerRadius="6" Padding="14" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Data disclosure" Foreground="#FFE0A33C"
                                   FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding PrivacyNotice}" Foreground="#FFD8D8D8"
                                   FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Providers -->
                <TextBlock Text="Intelligence Providers" Style="{StaticResource SectionHeader}"/>

                <ItemsControl ItemsSource="{Binding Providers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}"
                                              VerticalAlignment="Top" Margin="0,2,14,0"
                                              Foreground="White"
                                              ToolTip="Allow IOC-X to send indicators to this provider"/>

                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Foreground="White"
                                                       FontSize="15" FontWeight="SemiBold"/>
                                            <Border Background="#FF3D3D3D" CornerRadius="3"
                                                    Padding="7,2" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding StatusText}"
                                                           Foreground="#FFD8D8D8" FontSize="11"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Description}" Foreground="#FF9E9E9E"
                                                   FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>

                                        <TextBlock Foreground="#FF7E7E7E" FontSize="11" Margin="0,6,0,0"
                                                   TextWrapping="Wrap">
                                            <Run Text="Supports:"/>
                                            <Run Text="{Binding SupportedTypes, Mode=OneWay}"/>
                                            <Run Text="  •  Rate limit:"/>
                                            <Run Text="{Binding RateLimit, Mode=OneWay}"/>
                                        </TextBlock>

                                        <TextBlock Text="{Binding KeyStatus}" Foreground="#FF9E9E9E"
                                                   FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>

                                        <!-- Only shown where the app owns the key. -->
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                    Visibility="{Binding CanEditKey, Converter={StaticResource BoolToVisibility}}">
                                            <PasswordBox x:Name="KeyBox" Width="240" Padding="6,4"
                                                         Background="#FF1E1E1E" Foreground="White"
                                                         BorderBrush="#FF4A4A4A"/>
                                            <Button Content="Save key" Style="{StaticResource SubtleButton}"
                                                    Margin="8,0,0,0"
                                                    Click="OnSaveKeyClick"
                                                    Tag="{Binding}"
                                                    CommandParameter="{Binding ElementName=KeyBox}"/>
                                            <Button Content="Clear" Style="{StaticResource SubtleButton}"
                                                    Command="{Binding ClearKeyCommand}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" VerticalAlignment="Top">
                                        <Hyperlink NavigateUri="{Binding DocumentationUrl}"
                                                   RequestNavigate="OnNavigate"
                                                   Foreground="#FF6FA8DC">
                                            <Run Text="API docs"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Caching -->
                <TextBlock Text="Caching" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox Content="Reuse cached provider responses"
                                  IsChecked="{Binding CacheEnabled}" Foreground="White"/>
                        <TextBlock Text="Caching avoids re-sending an indicator to a provider that answered recently."
                                   Foreground="#FF7E7E7E" FontSize="11" Margin="0,4,0,10" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Cache lifetime (minutes)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding CacheTtlMinutes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource NumberBox}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Network -->
                <TextBlock Text="Network" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Request timeout (seconds)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource NumberBox}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Maximum concurrent requests" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding MaxConcurrency, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource NumberBox}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Scoring -->
                <TextBlock Text="Risk Thresholds" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="The score at which an indicator enters each risk band. Scores below the Medium threshold are rated Low or Informational."
                                   Foreground="#FF7E7E7E" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Medium at or above" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding MediumThreshold, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource NumberBox}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="High at or above" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding HighThreshold, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource NumberBox}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Critical at or above" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding CriticalThreshold, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource NumberBox}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Foreground="#FF6E6E6E" FontSize="11" Margin="0,4,0,20" TextWrapping="Wrap">
                    <Run Text="Settings file:"/>
                    <Run Text="{Binding SettingsFilePath, Mode=OneWay}"/>
                    <LineBreak/>
                    <Run Text="API keys are stored separately, encrypted for your Windows account, and never written to this file."/>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <!-- Action bar -->
        <Border Grid.Row="2" Background="#FF252525" BorderBrush="#FF3A3A3A"
                BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#FF9E9E9E"
                               FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Text="You have unsaved changes." Foreground="#FFE0A33C" FontSize="11"
                               Margin="0,2,0,0"
                               Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Discard changes" Style="{StaticResource SubtleButton}"
                            Command="{Binding ReloadCommand}"/>
                    <Button Content="Save settings" Style="{StaticResource ActionButton}"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
