<UserControl x:Class="IOCX.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IOCX.Wpf.Converters"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:RiskLevelToBrushConverter x:Key="RiskAccent"/>
        <conv:RiskLevelToFillConverter x:Key="RiskFill"/>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,24,0,10"/>
        </Style>

        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#FF9E9E9E"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="#FF1E1E1E" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Dashboard" Foreground="White" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#FF9E9E9E" FontSize="13" Margin="0,4,0,0"/>


            <TextBlock Text="Investigations by Risk" Style="{StaticResource SectionHeader}"/>
            <UniformGrid Columns="5">
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalInvestigations}" Style="{StaticResource StatValue}"/>
                        <TextBlock Text="Total" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding CriticalCount}" Style="{StaticResource StatValue}"
                                   Foreground="#FFE05C5C"/>
                        <TextBlock Text="Critical" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding HighCount}" Style="{StaticResource StatValue}"
                                   Foreground="#FFE0A33C"/>
                        <TextBlock Text="High" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding MediumCount}" Style="{StaticResource StatValue}"
                                   Foreground="#FFE0D23C"/>
                        <TextBlock Text="Medium" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="{Binding LowCount}" Style="{StaticResource StatValue}"
                                   Foreground="#FF6FCF5A"/>
                        <TextBlock Text="Low / Info" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Provider health -->
            <TextBlock Text="Provider Health" Style="{StaticResource SectionHeader}"/>
            <Border Background="#FF2D2D2D" CornerRadius="6" Padding="6">
                <ItemsControl ItemsSource="{Binding ProviderHealth}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FF9E9E9E"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF6FCF5A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Recent investigations -->
            <TextBlock Text="Recent Investigations" Style="{StaticResource SectionHeader}"/>

            <Border Background="#FF2D2D2D" CornerRadius="6" Padding="18"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Nothing here yet" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="Open the Investigate tab and analyse an indicator. Results are stored locally and will appear here."
                               Foreground="#FF9E9E9E" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Recent}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FF2D2D2D" CornerRadius="6" Margin="0,0,0,8"
                                BorderThickness="3,0,0,0"
                                BorderBrush="{Binding RiskLevel, Converter={StaticResource RiskAccent}}">
                            <Grid Margin="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Value}" Foreground="White" FontSize="14"
                                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Border Background="#FF3D3D3D" CornerRadius="3" Padding="6,2">
                                            <TextBlock Text="{Binding Type}" Foreground="#FF9E9E9E" FontSize="11"/>
                                        </Border>
                                        <TextBlock Text="{Binding StartedAt, StringFormat={}{0:MMM dd, yyyy HH:mm}}"
                                                   Foreground="#FF7E7E7E" FontSize="11" Margin="10,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">

                                    <Border CornerRadius="4" Padding="10,4" HorizontalAlignment="Right"
                                            Background="{Binding RiskLevel, Converter={StaticResource RiskFill}}"
                                            BorderThickness="1"
                                            BorderBrush="{Binding RiskLevel, Converter={StaticResource RiskAccent}}">
                                        <TextBlock Text="{Binding RiskLevel}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{Binding RiskLevel, Converter={StaticResource RiskAccent}}"/>
                                    </Border>
                                    <TextBlock Text="{Binding RiskScore, StringFormat=Risk {0}/100}"
                                               Foreground="#FF9E9E9E" FontSize="11"
                                               HorizontalAlignment="Right" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding ConfidenceScore, StringFormat=Confidence {0}%}"
                                               Foreground="#FF6FCF5A" FontSize="11"
                                               HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
